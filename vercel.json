{
  "redirects": [
    {
      "source": "/campussearch",
      "destination": "/campussearch/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/campussearch/",
      "destination": "https://campus-search-theta.vercel.app/index.html"
    },
    {
      "source": "/campussearch/:match*",
      "destination": "https://campus-search-theta.vercel.app/:match*"
    }
  ]
}
